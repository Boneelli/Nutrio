<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="12dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="#E0E0E0"
                app:cardCornerRadius="2dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp" />

            <TextView
                android:id="@+id/tvFiltriTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Filtra per:"
                android:textColor="#000000"
                android:textSize="20sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="20dp" />

            <!-- SEZIONE COSTO -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Costo"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderCosto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Basso"
                    android:textAlignment="center"
                    android:textColor="#757575"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Medio"
                    android:textAlignment="center"
                    android:textColor="#757575"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Alto"
                    android:textAlignment="center"
                    android:textColor="#757575"
                    android:textSize="12sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="20dp" />

            <!-- SEZIONE DIFFICOLTÀ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Difficoltà"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderDifficolta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Basso"
                    android:textAlignment="center"
                    android:textColor="#757575"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Medio"
                    android:textAlignment="center"
                    android:textColor="#757575"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Alto"
                    android:textAlignment="center"
                    android:textColor="#757575"
                    android:textSize="12sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="20dp" />

            <!-- SEZIONE TEMPO DI PREPARAZIONE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tempo di preparazione"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:spacing="8dp">

                <Button
                    android:id="@+id/btnTempo5"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:text="&lt;5 min"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    android:backgroundTint="#F0F0F0"
                    android:textColor="#666666"
                    app:cornerRadius="20dp" />

                <Button
                    android:id="@+id/btnTempo10"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:text="&lt;10 min"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    android:backgroundTint="#F0F0F0"
                    android:textColor="#666666"
                    app:cornerRadius="20dp" />

                <Button
                    android:id="@+id/btnTempo15"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:text="&lt;15 min"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    android:backgroundTint="#F0F0F0"
                    android:textColor="#666666"
                    app:cornerRadius="20dp" />

                <Button
                    android:id="@+id/btnTempo30"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:text="&lt;30 min"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    android:backgroundTint="#F0F0F0"
                    android:textColor="#666666"
                    app:cornerRadius="20dp" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="20dp" />

            <!-- SEZIONE CATEGORIA -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Categoria"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupCategorie"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="8dp"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipColazione"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Colazione"
                    android:textColor="@color/chip_text_selector"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_bg_selector"
                    app:chipCornerRadius="20dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPranzo"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pranzo"
                    android:textColor="@color/chip_text_selector"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_bg_selector"
                    app:chipCornerRadius="20dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCena"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cena"
                    android:textColor="@color/chip_text_selector"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_bg_selector"
                    app:chipCornerRadius="20dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSpuntino"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Spuntino"
                    android:textColor="@color/chip_text_selector"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_bg_selector"
                    app:chipCornerRadius="20dp" />

            </com.google.android.material.chip.ChipGroup>

            <View
                android:layout_width="match_parent"
                android:layout_height="20dp" />

            <!-- SEZIONE PREFERENZE ALIMENTARI -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Preferenze alimentari"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupPreferenze"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="8dp"
                app:singleSelection="false">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSenzaGlutine"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Senza glutine"
                    android:textColor="@color/chip_text_selector"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_bg_selector"
                    app:chipCornerRadius="20dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSenzaLattosio"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Senza lattosio"
                    android:textColor="@color/chip_text_selector"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_bg_selector"
                    app:chipCornerRadius="20dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipVegano"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vegano"
                    android:textColor="@color/chip_text_selector"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_bg_selector"
                    app:chipCornerRadius="20dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipVegetariano"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vegetariano"
                    android:textColor="@color/chip_text_selector"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_bg_selector"
                    app:chipCornerRadius="20dp" />

            </com.google.android.material.chip.ChipGroup>

            <View
                android:layout_width="match_parent"
                android:layout_height="20dp" />

            <!-- BOTTONI RESET / APPLICA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/btnResetFilters"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reset"
                    android:textColor="#9E9E9E"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:padding="8dp"
                    android:clickable="true"
                    android:focusable="true" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnApplyFilters"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="2"
                    android:backgroundTint="#708256"
                    android:text="Applica"
                    android:textSize="16sp"
                    android:textAllCaps="false"
                    app:cornerRadius="26dp"
                    app:elevation="0dp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>