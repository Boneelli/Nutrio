<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Filtri"
        android:textStyle="bold"
        android:textSize="18sp"
        android:paddingBottom="8dp"
        android:textColor="#000" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Categoria"
        android:textSize="14sp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCatPrimi"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Primi"
            android:layout_marginEnd="8dp"
            app:backgroundTint="#000000"
            android:textColor="#FFFFFF"
            app:strokeColor="#708256"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCatSecondi"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Secondi"
            android:layout_marginEnd="8dp"
            app:backgroundTint="#000000"
            android:textColor="#FFFFFF"
            app:strokeColor="#708256"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCatDolci"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dolci"
            app:backgroundTint="#000000"
            android:textColor="#FFFFFF"
            app:strokeColor="#708256"
            app:strokeWidth="1dp" />

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Preferenze"
        android:textSize="14sp"
        android:paddingTop="16dp"
        android:paddingBottom="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPrefVegano"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vegano"
            android:layout_marginEnd="8dp"
            app:backgroundTint="#000000"
            android:textColor="#FFFFFF"
            app:strokeColor="#708256"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPrefSenzaGlutine"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Senza glutine"
            app:backgroundTint="#000000"
            android:textColor="#FFFFFF"
            app:strokeColor="#708256"
            app:strokeWidth="1dp" />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnApply"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Applica"
        android:layout_marginTop="20dp"
        app:backgroundTint="#708256"
        android:textColor="#FFFFFF" />

</LinearLayout>