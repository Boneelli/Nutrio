<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Nutrio" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.Nutrio" parent="Base.Theme.Nutrio" />

    <style name="CircleImageView">
        <item name="cornerSize">50%</item>
    </style>

    <!-- Stile condiviso per le card delle ricette (CSS-like) -->
    <style name="NutrioRecipeCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">4dp</item>
        <item name="cardBackgroundColor">@android:color/white</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">#708256</item>
    </style>

    <!-- Stile per il titolo della ricetta nelle card -->
    <style name="NutrioRecipeTitle">
        <item name="android:textColor">#708256</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:padding">12dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">2</item>
    </style>

    <!-- Stile per il badge del rating -->
    <style name="NutrioRatingBadge">
        <item name="cardBackgroundColor">#708256</item>
        <item name="cardCornerRadius">8dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeWidth">0dp</item>
    </style>
</resources>
